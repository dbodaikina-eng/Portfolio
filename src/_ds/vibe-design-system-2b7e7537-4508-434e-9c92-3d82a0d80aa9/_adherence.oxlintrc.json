{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/buttons/**",
              "components/core/**",
              "components/feed/**",
              "components/feedback/**",
              "components/forms/**",
              "components/media/**",
              "components/navigation/**",
              "ui_kits/vibe-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fredoka))/i]",
        "message": "Font not provided by the design system. Available: Fredoka."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|size|ring|edit|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, alt, size, ring, edit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:l|m|s)$/]",
        "message": "<Avatar> size must be one of 'l' | 'm' | 's'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:pad|radius|elevated|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: pad, radius, elevated, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|size|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, size, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:m|s)$/]",
        "message": "<Checkbox> size must be one of 'm' | 's'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Counter'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|children|style|key|ref|className|style|children)$/]",
        "message": "<Counter> doesn't accept that prop. Declared props: theme, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Counter'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:blue|dark|light)$/]",
        "message": "<Counter> theme must be one of 'blue' | 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EllipseButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|pressed|disabled|icon|key|ref|className|style|children)$/]",
        "message": "<EllipseButton> doesn't accept that prop. Declared props: variant, size, pressed, disabled, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='EllipseButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|destructive)$/]",
        "message": "<EllipseButton> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EllipseButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:l|m|s)$/]",
        "message": "<EllipseButton> size must be one of 'l' | 'm' | 's'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeartButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:liked|kind|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<HeartButton> doesn't accept that prop. Declared props: liked, kind, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeartButton'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:like|dislike)$/]",
        "message": "<HeartButton> kind must be one of 'like' | 'dislike'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|focused|icon|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, placeholder, focused, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|value|trailing|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: icon, title, value, trailing, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MusicCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:cover|size|rotate|playing|onToggle|style|key|ref|className|style|children)$/]",
        "message": "<MusicCard> doesn't accept that prop. Declared props: cover, size, rotate, playing, onToggle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|leading|trailing|style|key|ref|className|style|children)$/]",
        "message": "<NavHeader> doesn't accept that prop. Declared props: title, onBack, leading, trailing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|active|theme|style|key|ref|className|style|children)$/]",
        "message": "<PageControl> doesn't accept that prop. Declared props: count, active, theme, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageControl'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<PageControl> theme must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: checked, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RectButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|pressed|disabled|fullWidth|icon|children|key|ref|className|style|children)$/]",
        "message": "<RectButton> doesn't accept that prop. Declared props: variant, size, pressed, disabled, fullWidth, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='RectButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|destructive)$/]",
        "message": "<RectButton> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RectButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:m|s)$/]",
        "message": "<RectButton> size must be one of 'm' | 's'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: on, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabbarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|active|count|onClick|key|ref|className|style|children)$/]",
        "message": "<TabbarItem> doesn't accept that prop. Declared props: icon, label, active, count, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: selected, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:arrow|children|style|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: arrow, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='arrow'] > Literal[value!=/^(?:top|bottom|left|right)$/]",
        "message": "<Tooltip> arrow must be one of 'top' | 'bottom' | 'left' | 'right'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
